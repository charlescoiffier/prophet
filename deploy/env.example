# Modèle de ~/srv/paroletenue/.env sur le VPS (jamais dans git).
# Les réglages non secrets (base, Redis, URL…) sont dans deploy/docker-compose.yml.

# Clé de l'application : générer avec « php artisan key:generate --show »
APP_KEY=

# Mot de passe PostgreSQL (aussi utilisé par le conteneur postgres) : « openssl rand -hex 24 »
DB_PASSWORD=

# Accès protégé pendant les tests (Traefik basic auth), entre apostrophes simples :
#   echo "admin:$(openssl passwd -apr1)"   puis coller le résultat ici
BASIC_AUTH_USERS='admin:$apr1$...'

# E-mails : SMTP de l'offre e-mail OVH, adresse dédiée (SPF, DKIM, DMARC configurés)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Parole tenue"

# Facultatif : clés « Save Page Now » d'archive.org (quota plus large)
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=
